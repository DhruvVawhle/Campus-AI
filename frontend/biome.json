{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/.next",
			"!**/.next-dev",
			"!**/node_modules"
		]
	},
	"formatter": {
		"enabled": false
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noImportantStyles": "off"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
